# Cópialo a .env (ignorado por git) y ajusta los valores.

# compose.yaml: red de Nginx Proxy Manager.
PROXY_NETWORK=npm_default

# export.py: catálogo cic_scrape (lo leen con `uv run --env-file .env ...`).
# Solo la contraseña es obligatoria; los demás valores son los de por defecto.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=theiss
POSTGRES_PASSWORD=
POSTGRES_DB=cic_scrape

# openalex.py: llave gratuita de OpenAlex (opcional; multiplica el presupuesto diario).
OPENALEX_API_KEY=

# búsqueda semántica en Encuentra tu lab (API Qwen de Alibaba Cloud).
# La clave se usa solo desde el servidor y nunca se publica en el navegador.
DASHSCOPE_API_KEY=
